DATABASE_URL=sqlite:///./monstera.db
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
OPEN_METEO_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
COOKIE_SECURE=false
SESSION_DAYS=14
ROUTING_PROVIDER_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=8
ROUTING_MAX_ALTERNATIVES=3
ROUTING_SAMPLE_INTERVAL_M=1000
ROUTING_MAX_SAMPLES_PER_ROUTE=8
PROVIDER_CACHE_MAX_ENTRIES=512
FORECAST_CACHE_TTL_SECONDS=2700
GEOCODING_CACHE_TTL_SECONDS=86400
ROUTE_CACHE_TTL_SECONDS=1200
